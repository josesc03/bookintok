# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=bookintok
POSTGRES_PASSWORD=change-me
# Firebase project id: used only to validate ID tokens (no service account key is needed)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Push notifications (optional): put the Firebase service account key at
# secrets/firebase-service-account.json (git-ignored). Without it the chat works without push.

# Android APK built by docker compose (values from Firebase console > Project settings > Android app)
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=
FIREBASE_WEB_CLIENT_ID=
# 10.0.2.2 = your PC seen from the emulator. For a real phone use your PC's LAN IP
APK_API_BASE_URL=http://10.0.2.2:8080
APK_CHAT_BASE_URL=ws://10.0.2.2:8081
